{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120
    },
    "api/checkout.js": {
      "maxDuration": 10
    },
    "api/checkout-proprio.js": {
      "maxDuration": 10
    },
    "api/checkout-pro.js": {
      "maxDuration": 10
    },
    "api/webhook.js": {
      "maxDuration": 10
    },
    "api/webhook-pro.js": {
      "maxDuration": 10
    },
    "api/send-mail.js": {
      "maxDuration": 30
    },
    "api/trial-reminder.js": {
      "maxDuration": 60
    },
    "api/quittances-auto.js": {
      "maxDuration": 60
    },
    "api/send-welcome.js": {
      "maxDuration": 30
    },
    "api/cron-trial-reminders.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/cancel-subscription.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/trial-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/quittances-auto",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron-trial-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bailscan.app"
        }
      ],
      "destination": "https://bailscan.app/$1",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
